# ============================================================
# Sweety Client — Environment Variables Template
# Copy this file to .env and update if your backend runs on a different port.
# Variables prefixed with VITE_ are bundled into the browser — never put secrets here.
# ============================================================

# Base URL of the backend API (no trailing slash)
# Local development: the Express API on port 5000.
# Production (Vercel): set VITE_API_URL in the Vercel project settings to the
# deployed Render URL, e.g. https://sweety-api.onrender.com
# This value is baked in at build time — redeploy Vercel after changing it.
VITE_API_URL=http://localhost:5000
